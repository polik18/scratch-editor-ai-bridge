{
  "version": 1,
  "description": "Ten student-style game requests. Each control lists a key and the stage axis/direction some sprite must move while the key is held. 'clicks' cases are driven by clicking visible sprites instead of keys.",
  "cases": [
    {
      "id": "catch-apples",
      "request": "做一個貓咪接蘋果的遊戲，用左右鍵移動貓咪，蘋果從天上掉下來，接到加分，漏接扣生命",
      "controls": [
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 }
      ],
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "space-dodge",
      "request": "太空船躲隕石：左右鍵移動火箭，隕石越來越快，活越久分數越高，撞到就結束",
      "controls": [
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 }
      ],
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "space-shooter",
      "request": "太空射擊遊戲：左右鍵移動，空白鍵發射雷射打外星人，打中加分，外星人碰到我就輸",
      "controls": [
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 },
        { "key": " ", "axis": "y", "sign": 1 }
      ],
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "mouse-maze",
      "request": "老鼠走迷宮：用上下左右鍵控制老鼠，碰到牆會退回去，找到起司就過關",
      "controls": [
        { "key": "ArrowUp", "axis": "y", "sign": 1 },
        { "key": "ArrowDown", "axis": "y", "sign": -1 },
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 }
      ],
      "expectAutonomousMotion": false,
      "expectProgress": false
    },
    {
      "id": "jump-collect",
      "request": "平台跳躍遊戲：左右鍵走路、空白鍵跳，收集星星加分，掉到底下就重來",
      "controls": [
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 },
        { "key": " ", "axis": "y", "sign": 1 }
      ],
      "expectAutonomousMotion": false,
      "expectProgress": true
    },
    {
      "id": "pop-balloons",
      "request": "點氣球遊戲：氣球會從下面飄上來，用滑鼠點破氣球得分，30 秒倒數結束顯示分數",
      "controls": [],
      "clicks": true,
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "two-player-pong",
      "request": "雙人乒乓球：左邊玩家用 W/S，右邊玩家用上下鍵，球碰到球拍反彈，漏球對方得分",
      "controls": [
        { "key": "w", "axis": "y", "sign": 1 },
        { "key": "s", "axis": "y", "sign": -1 },
        { "key": "ArrowUp", "axis": "y", "sign": 1 },
        { "key": "ArrowDown", "axis": "y", "sign": -1 }
      ],
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "deep-sea-rescue",
      "request": "深海救援：用方向鍵控制小魚游動，收集氧氣泡泡，躲開水母，氧氣用完就輸",
      "controls": [
        { "key": "ArrowUp", "axis": "y", "sign": 1 },
        { "key": "ArrowDown", "axis": "y", "sign": -1 },
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 }
      ],
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "car-racing",
      "request": "賽車閃避：我的車在下面用左右鍵換車道，前面的車一直開下來，閃過越多分數越高",
      "controls": [
        { "key": "ArrowLeft", "axis": "x", "sign": -1 },
        { "key": "ArrowRight", "axis": "x", "sign": 1 }
      ],
      "expectAutonomousMotion": true,
      "expectProgress": true
    },
    {
      "id": "whack-a-mole",
      "request": "打地鼠：地鼠會隨機從洞裡冒出來，用滑鼠點到就加分，時間到遊戲結束",
      "controls": [],
      "clicks": true,
      "expectAutonomousMotion": true,
      "expectProgress": true
    }
  ]
}
