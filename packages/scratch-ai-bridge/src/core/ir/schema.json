{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scratch.mit.edu/schemas/scratch-ai-bridge/canonical-ir-v1.json",
  "title": "Scratch AI Bridge Canonical IR",
  "description": "ID-free canonical representation used between AI-facing authoring data and Scratch VM adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "stage", "sprites", "broadcasts"],
  "properties": {
    "format": {
      "const": "scratch-ai-bridge/canonical-ir"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "$ref": "#/definitions/stage"
    },
    "sprites": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sprite"
      }
    },
    "broadcasts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/broadcast"
      }
    }
  },
  "definitions": {
    "scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/definitions/scalar"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": {
              "const": "variable"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": {
              "const": "list"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": {
              "const": "broadcast"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "block"],
          "properties": {
            "type": {
              "const": "block"
            },
            "block": {
              "$ref": "#/definitions/block"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "blocks"],
          "properties": {
            "type": {
              "const": "stack"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/block"
              }
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opcode"],
      "properties": {
        "opcode": {
          "enum": [
            "event_whenflagclicked",
            "motion_movesteps",
            "looks_say",
            "control_wait",
            "control_repeat",
            "control_forever",
            "control_if",
            "control_if_else",
            "data_setvariableto",
            "data_changevariableby",
            "event_broadcast",
            "event_whenbroadcastreceived"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/input"
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/scalar"
          }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks"],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/block"
          }
        },
        "position": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/definitions/scalar"
        },
        "cloud": {
          "type": "boolean"
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/scalar"
          }
        }
      }
    },
    "broadcast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "procedureParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "default"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["string-number", "boolean"]
        },
        "default": {
          "$ref": "#/definitions/scalar"
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters", "warp", "body"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/procedureParameter"
          }
        },
        "warp": {
          "type": "boolean"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          }
        }
      }
    },
    "costume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dataFormat"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dataFormat": {
          "enum": ["svg", "png", "jpg", "jpeg", "bmp"]
        },
        "data": {
          "type": "string"
        },
        "rotationCenterX": {
          "type": "number"
        },
        "rotationCenterY": {
          "type": "number"
        },
        "bitmapResolution": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dataFormat"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dataFormat": {
          "enum": ["wav", "mp3"]
        },
        "data": {
          "type": "string"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampleCount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "variables", "lists", "costumes", "sounds", "scripts", "procedures"],
      "properties": {
        "kind": {
          "const": "stage"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/variable"
          }
        },
        "lists": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/list"
          }
        },
        "costumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/costume"
          }
        },
        "sounds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sound"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/script"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/procedure"
          }
        }
      }
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "variables",
        "lists",
        "costumes",
        "sounds",
        "scripts",
        "procedures",
        "x",
        "y",
        "direction",
        "size",
        "visible",
        "draggable",
        "rotationStyle"
      ],
      "properties": {
        "kind": {
          "const": "sprite"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/variable"
          }
        },
        "lists": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/list"
          }
        },
        "costumes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/costume"
          }
        },
        "sounds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sound"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/script"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/procedure"
          }
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "direction": {
          "type": "number"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "visible": {
          "type": "boolean"
        },
        "draggable": {
          "type": "boolean"
        },
        "rotationStyle": {
          "enum": ["all around", "left-right", "don't rotate"]
        }
      }
    }
  }
}
