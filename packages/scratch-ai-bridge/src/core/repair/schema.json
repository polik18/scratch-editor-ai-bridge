{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polik18.github.io/scratch-editor-ai-bridge/schemas/repair-report-v1.json",
  "title": "Scratch AI Bridge Repair Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "canonicalVersion", "projectName", "summary", "issues"],
  "properties": {
    "format": { "const": "scratch-ai-bridge/repair-report" },
    "version": { "const": 1 },
    "canonicalVersion": { "const": 1 },
    "projectName": { "type": "string" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autoRepaired", "errors", "warnings"],
      "properties": {
        "autoRepaired": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "status", "phase", "code", "path", "message", "suggestion"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "status": { "enum": ["auto-repaired", "review", "must-fix"] },
          "phase": { "enum": ["parse", "normalize", "schema", "semantic", "compile"] },
          "code": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/" },
          "opcode": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "actual": true,
          "expected": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string", "minLength": 1 },
          "example": true
        }
      }
    }
  }
}
