{
  "name": "@scratch/scratch-ai-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first AI bridge for creating, validating, and editing Scratch projects, with local CLI and MCP companions.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "audit:reachability": "node scripts/tools/check-audit-reachability.mjs",
    "bench": "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\" && vitest bench --run tests/performance --outputJson=test-results/performance.json && node scripts/bench/check-performance-budget.mjs test-results/performance.json",
    "benchmark:games": "tsx scripts/bench/game-benchmark.ts",
    "benchmark:scratchblocks": "tsx scripts/bench/scratchblocks-benchmark.ts",
    "build": "tsc --noEmit && vite build && node scripts/build/copy-renderer-sandbox-assets.mjs && node scripts/build/generate-service-worker.mjs && node scripts/build/check-bundle-budget.mjs",
    "clean": "rimraf dist coverage",
    "cli": "tsx src/cli/main.ts",
    "dev": "vite",
    "feedback:corpus:generate": "node scripts/bench/generate-feedback-corpus.mjs",
    "feedback:review": "node scripts/bench/evaluate-feedback-reviews.mjs",
    "generate:asset-library": "node scripts/build/generate-asset-library-index.mjs",
    "generate:validator": "node scripts/build/generate-validator.mjs",
    "lint": "eslint . && prettier --check .",
    "mcp": "tsx src/mcp/main.ts",
    "mcp:http": "tsx src/mcp/http-main.ts",
    "measure:archive-memory": "node --expose-gc scripts/bench/measure-archive-memory.mjs",
    "measure:fragment-budget": "tsx scripts/bench/measure-project-fragment-budget.ts",
    "model-gateway": "tsx src/provider-gateway/main.ts",
    "prebuild": "npm run generate:validator",
    "predev": "npm run generate:validator",
    "pretest": "npm run generate:validator",
    "preview": "vite preview",
    "session": "tsx src/cli/session-cli.ts",
    "sync-server": "tsx src/progress-sync/main.ts",
    "test": "vitest run",
    "test:browser": "node scripts/smoke/browser-smoke.mjs",
    "test:browser:firefox": "BROWSER=firefox node scripts/smoke/browser-smoke.mjs",
    "test:browser:safari": "node scripts/smoke/safari-smoke.mjs",
    "test:browser:webkit": "BROWSER=webkit node scripts/smoke/browser-smoke.mjs",
    "test:open-project-browser": "node scripts/smoke/open-project-browser-smoke.mjs",
    "test:asset-library-browser": "node scripts/smoke/asset-library-browser-smoke.mjs",
    "test:student-flow": "node scripts/smoke/student-flow-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@noble/hashes": "1.8.0",
    "@scratch/scratch-render": "15.2.0",
    "@scratch/scratch-storage": "15.2.0",
    "@scratch/scratch-svg-renderer": "15.2.0",
    "@scratch/scratch-vm": "15.2.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "jszip": "3.10.2",
    "scratch-audio": "2.0.268",
    "zod": "^4.6.5"
  },
  "bin": {
    "scratch-ai-bridge": "bin/scratch-ai-bridge.mjs",
    "scratch-ai-bridge-mcp": "bin/scratch-ai-bridge-mcp.mjs",
    "scratch-ai-bridge-mcp-http": "bin/scratch-ai-bridge-mcp-http.mjs",
    "scratch-ai-bridge-model-gateway": "bin/scratch-ai-bridge-model-gateway.mjs",
    "scratch-ai-bridge-sync": "bin/scratch-ai-bridge-sync.mjs",
    "scratch-session": "bin/scratch-session.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.83",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.2",
    "scratch-parser": "6.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.11"
  }
}
