{
  "name": "@scratch/scratch-ai-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Pure front-end bridge between AI-authored JSON and Scratch projects.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/copy-renderer-sandbox-assets.mjs && node scripts/generate-service-worker.mjs && node scripts/check-bundle-budget.mjs",
    "cli": "tsx src/cli/main.ts",
    "session": "tsx src/cli/session-cli.ts",
    "bench": "node -e \"require('node:fs').mkdirSync('test-results',{recursive:true})\" && vitest bench --run tests/performance --outputJson=test-results/performance.json && node scripts/check-performance-budget.mjs test-results/performance.json",
    "audit:reachability": "node scripts/check-audit-reachability.mjs",
    "clean": "rimraf dist coverage",
    "dev": "vite",
    "generate:validator": "node scripts/generate-validator.mjs",
    "feedback:review": "node scripts/evaluate-feedback-reviews.mjs",
    "feedback:corpus:generate": "node scripts/generate-feedback-corpus.mjs",
    "lint": "eslint . && prettier --check .",
    "measure:archive-memory": "node --expose-gc scripts/measure-archive-memory.mjs",
    "prebuild": "npm run generate:validator",
    "predev": "npm run generate:validator",
    "pretest": "npm run generate:validator",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:firefox": "BROWSER=firefox node scripts/browser-smoke.mjs",
    "test:browser:webkit": "BROWSER=webkit node scripts/browser-smoke.mjs",
    "test:browser:safari": "node scripts/safari-smoke.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scratch/scratch-render": "15.2.0",
    "@scratch/scratch-storage": "15.2.0",
    "@scratch/scratch-svg-renderer": "15.2.0",
    "@scratch/scratch-vm": "15.2.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "jszip": "3.10.2",
    "scratch-audio": "2.0.268"
  },
  "bin": {
    "scratch-ai-bridge": "scripts/scratch-ai-bridge.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.83",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.2",
    "scratch-parser": "6.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.11"
  }
}
